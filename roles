# ==============================================================
# بخش ۲ سند — نقش‌ها و سطح دسترسی (RBAC)
# ==============================================================
#
# نحوه‌ی اضافه کردن به کد فعلی‌تان:
#   این کد را داخل sefareshbot.py، بلافاصله بعد از تابع `is_seller`
#   (یعنی بعد از بخش موجود «مدیریت نقش‌ها») بچسبانید.
#
# وابستگی‌ها (این‌ها از قبل در کد فعلی شما هستند و دوباره تعریف نمی‌شوند):
#   - _load(path, default) / _save(path, data)
#   - get_role(user_id)   -> "admin" | "manager" | "expert" | "seller" | None
#   - admin_ID
#   - load_stores() / get_store_owner(store_id) از بخش مدیریت فروشگاه
#
# این فایل دو کار می‌کند:
#   ۱. یک مدل داده جدید اضافه می‌کند: رابطه‌ی «کارشناس فروش <-> فروشگاه‌های
#      تحت مدیریتش» (store_experts.json) — چیزی که در کد فعلی شما وجود نداشت
#      و بخش ۲.۳ و ۲.۵ سند صراحتاً به آن نیاز دارند.
#   ۲. یک لایه‌ی permission تعریف می‌کند: هر مسئولیتی که در بخش ۲.۱ تا ۲.۴
#      سند نوشته شده، یک تابع can_xxx(user_id) یا can_xxx(user_id, store_id)
#      مجزا دارد — تا در بقیه‌ی کد به‌جای پراکنده چک کردن role == "..."،
#      همیشه از این توابع استفاده کنید. اسم هر تابع را عمداً مطابق متن
#      دقیق سند گذاشته‌ام تا ردیابی‌اش بین سند و کد ساده باشد.
#
# ==============================================================


# ------------------------------------------------------------
# ۲.۳ / ۲.۵ — رابطه‌ی کارشناس فروش <-> فروشگاه‌های تحت مدیریت
# ------------------------------------------------------------
# «هر کارشناس فروش می‌تواند چندین فروشگاه را مدیریت کند» (بخش ۳.۱)
# «هر فروشگاه فقط به یک کارشناس فروش متصل است» (بخش ۲.۵ و ۳.۱)
#
# ساختار فایل store_experts.json:
#   { "<store_id>": "<expert_user_id>" }

STORE_EXPERTS_DB = "store_experts.json"


def load_store_experts():
    return _load(STORE_EXPERTS_DB, {})


def save_store_experts(data):
    _save(STORE_EXPERTS_DB, data)


def get_store_expert(store_id):
    """کارشناس فروش مسئولِ یک فروشگاه را برمی‌گرداند، یا None."""
    return load_store_experts().get(str(store_id))


def get_stores_of_expert(expert_id):
    """لیست store_id هایی که یک کارشناس فروش مسئول آن‌هاست."""
    assigns = load_store_experts()
    eid = str(expert_id)
    return [sid for sid, exp in assigns.items() if exp == eid]


def assign_expert_to_store(store_id, expert_id, assigned_by=None):
    """
    اتصال یک فروشگاه به یک کارشناس فروش.
    طبق بخش ۲.۱ و ۳.۱: «فقط مدیر سامانه می‌تواند کارشناس فروش یک
    فروشگاه را تغییر دهد.»
    """
    if assigned_by is not None and not can_change_store_expert(assigned_by):
        return False, "فقط مدیر سامانه می‌تواند کارشناس فروشگاه را تغییر دهد."
    if get_role(expert_id) != "expert":
        return False, "کاربر انتخاب‌شده نقش کارشناس فروش ندارد."
    assigns = load_store_experts()
    assigns[str(store_id)] = str(expert_id)
    save_store_experts(assigns)
    return True, "کارشناس فروش این فروشگاه با موفقیت تنظیم شد."


def unassign_store_expert(store_id):
    assigns = load_store_experts()
    assigns.pop(str(store_id), None)
    save_store_experts(assigns)


