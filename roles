def can_view_managed_stores(user_id):
    """مشاهده فروشگاه‌های تحت مدیریت خودش."""
    return get_role(user_id) in ("admin", "manager", "expert")


def can_set_store_inventory(user_id, store_id):
    """
    ثبت موجودی اولیه یک فروشگاه.
    فقط برای فروشگاه‌های تحت مدیریت همان کارشناس (یا admin/manager با دسترسی کامل).
    """
    role = get_role(user_id)
    if role in ("admin", "manager"):
        return True
    if role == "expert":
        return str(store_id) in get_stores_of_expert(user_id)
    return False


def can_view_store_orders(user_id, store_id):
    """مشاهده سفارش‌های یک فروشگاه مشخص."""
    role = get_role(user_id)
    if role in ("admin", "manager"):
        return True
    if role == "expert":
        return str(store_id) in get_stores_of_expert(user_id)
    if role == "seller":
        return get_store_owner(str(store_id)) == str(user_id)
    return False


def can_approve_order_as_expert(user_id, order):
    """
    تأیید سفارش توسط کارشناس فروش.
    فقط اگر سفارش متعلق به یکی از فروشگاه‌های تحت مدیریت همین کارشناس باشد
    و وضعیت سفارش submitted باشد.
    """
    role = get_role(user_id)
    if role == "admin":
        return order.get("status") == "submitted"
    if role != "expert":
        return False
    store_id = order.get("store_id")
    return (
        order.get("status") == "submitted"
        and str(store_id) in get_stores_of_expert(user_id)
    )


def can_reject_order_as_expert(user_id, order):
    """رد سفارش توسط کارشناس فروش — همان شرط تأیید."""
    return can_approve_order_as_expert(user_id, order)


def can_edit_rejected_order(user_id, order):
    """
    ویرایش سفارش‌های رد شده.
    طبق بخش ۳.۶: «سفارش رد شده فقط توسط کارشناس فروش قابل ویرایش است.»
    """
    role = get_role(user_id)
    if role == "admin":
        return order.get("status") in ("expert_rejected", "manager_rejected")
    if role != "expert":
        return False
    store_id = order.get("store_id")
    return (
        order.get("status") in ("expert_rejected", "manager_rejected")
        and str(store_id) in get_stores_of_expert(user_id)
    )


