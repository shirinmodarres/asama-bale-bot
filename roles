# ------------------------------------------------------------
# ۲.۵ — قوانین دسترسی عمومی (Scoping Helpers)
# ------------------------------------------------------------
# این توابع برای فیلتر کردن لیست‌ها استفاده می‌شوند (مثلاً «همه‌ی سفارش‌ها»
# در دیتابیس را می‌گیریم و بر اساس نقش کاربر فیلتر می‌کنیم) تا هیچ کجای
# کد به‌طور تصادفی داده‌ی خارج از محدوده‌ی مجاز کاربر نمایش داده نشود.

def get_visible_store_ids(user_id):
    """
    لیست store_id هایی که این کاربر مجاز به دیدن آن‌هاست.
    - admin / manager: همه‌ی فروشگاه‌ها
    - expert: فقط فروشگاه‌های تحت مدیریتش
    - seller: فقط فروشگاه خودش
    """
    role = get_role(user_id)
    if role in ("admin", "manager"):
        return list(load_stores().keys())
    if role == "expert":
        return get_stores_of_expert(user_id)
    if role == "seller":
        sid = get_store_owner_of_user(user_id)
        return [sid] if sid else []
    return []


def get_store_owner_of_user(user_id):
    """
    برعکسِ get_store_owner: فروشگاهی که این کاربر (seller) مالک آن است.
    فرض بر این است که تابع get_store_by_seller در کد فعلی شما وجود دارد
    (در هر دو نسخه‌ی کد فایلتان این تابع با همین نام تعریف شده).
    """
    return get_store_by_seller(user_id)


def filter_orders_visible_to_user(user_id, all_orders_iterable):
    """
    all_orders_iterable: iterable از (uid, order_dict) — مثل خروجی
    iter_all_orders() که در کد دوم شما موجود است.

    خروجی: فقط سفارش‌هایی که کاربر طبق بخش ۲.۵ مجاز به دیدنشان است.
    """
    role = get_role(user_id)
    if role in ("admin", "manager"):
        yield from all_orders_iterable
        return
    if role == "expert":
        my_stores = set(get_stores_of_expert(user_id))
        for uid, order in all_orders_iterable:
            if str(order.get("store_id")) in my_stores:
                yield uid, order
        return
    if role == "seller":
        my_store = get_store_owner_of_user(user_id)
        for uid, order in all_orders_iterable:
            if my_store and str(order.get("store_id")) == str(my_store):
                yield uid, order
        return
    return


