def get_permission_summary_text(user_id):
    role = get_role(user_id)
    if not role:
        return "این کاربر هیچ نقشی در سیستم ندارد."
    items = ROLE_PERMISSIONS_SUMMARY.get(role, [])
    lines = [f"نقش: {role}", "", "دسترسی‌های شما:"]
    lines += [f"• {item}" for item in items]
    return "\n".join(lines)
