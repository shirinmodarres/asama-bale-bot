# local or production
APP_ENV=local

# Local bot and DB. Use a separate Bale bot token for local testing.
BOT_TOKEN_LOCAL=your-local-bale-bot-token
MONGO_URI_LOCAL=mongodb://localhost:27017
MONGO_DB_NAME_LOCAL=asama_bot_local

# Production bot and DB. Do not use these while APP_ENV=local.
BOT_TOKEN_PRODUCTION=your-production-bale-bot-token
MONGO_URI_PRODUCTION=mongodb://localhost:27017
MONGO_DB_NAME_PRODUCTION=asama_bot

# Local role IDs. Keep these separate from production when possible.
LOCAL_ADMIN_IDS=583160697
LOCAL_SALES_MANAGER_ID=132500720
LOCAL_EXPERT_ID=700144333
