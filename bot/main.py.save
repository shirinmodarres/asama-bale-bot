from bot.handlers.admin_panel import (
    admin_panel, admin_menu_callback, receive_admin_reject_reason,
    ADMIN_REJECT_REASON,
)

logger = logging.getLogger(__name__)


def get_state(context: dict) -> int | None:
    return context.get("state")


def set_state(context: dict, state: int | None):
    if state is None:
        context.pop("state", None)
    else:
        context["state"] = state


def _is_bot_access_allowed(user_id: int, admin_service: AdminService) -> bool:
    role = get_role(user_id)
    if admin_service.bot_active():
        return True
    return role in {"admin", "sales_manager"}


# ====== هندلر مرکزی متن ======
async def handle_text(message: Message, context: dict):
    text = message.content.strip() if message.content else ""
    current_state = get_state(context)

    logger.info(f"📩 handle_text: state={current_state}, text={text}")

    # ====== دکمه‌های منوی اصلی ======
    if text == BTN_REQUEST_GOODS:
        await request_goods(message, context)
        return
    if text == BTN_CREATE_ORDER:
        await order_start(message, context)
        return
    if text == BTN_MY_REQUESTS:
        await my_requests(message, context)
        return
    if text == BTN_WALLET:
        await show_wallet(message, context)
        return
    if text == BTN_PENDING_REQUESTS:
        await pending_requests(message, context)
        return
    if text == BTN_PENDING_ORDERS:
        await pending_orders(message, context)
        return
    if text == BTN_EDIT_SELLER:
        await edit_seller_start(message, context)
        return
    if text == BTN_EXPORT:
        await export_requests(message, context)
        return
    if text == BTN_EXPORT_ORDERS:
        await export_orders(message, context)
        return
    if text == BTN_INFO:
        await bot_info(message, context)
        return
    if text == BTN_ADMIN_MANAGEMENT:
        await admin_panel(message, context)
        return
    if text == BTN_ADMIN_MANAGE_PRODUCTS:
        await message.reply(MESSAGES["admin_products_list"], components=admin_products_menu())
        return
    if text == BTN_ADMIN_MANAGE_STORES:
        await message.reply(MESSAGES["admin_stores_list"], components=admin_stores_menu())
        return
    if text == BTN_ADMIN_MANAGE_EXPERTS:
        await message.reply(MESSAGES["admin_experts_list"], components=admin_experts_menu())
        return
    if text == BTN_ADMIN_MANAGE_BOT:
        await message.reply(
            MESSAGES["admin_bot_status"].format(
                active=MESSAGES["bot_status_on"] if context["admin_service"].bot_active() else MESSAGES["bot_status_off"]
            ),
            components=admin_bot_menu(context["admin_service"].bot_active()),
        )
        return
    if text == BTN_ADMIN_ACTION_REQUESTS:
        await message.reply(MESSAGES["admin_action_requests"], components=admin_action_requests_keyboard(context["admin_service"].list_admin_action_requests()))
        return
    if text == BTN_ADMIN_ACTIVE_PRODUCTS:
        await message.reply(
            MESSAGES["admin_products_list_title"].format(status=MESSAGES["active_status"]),
            components=product_status_keyboard(context["admin_service"].list_products(active=True), back_callback="admin:products"),
        )
        return
    if text == BTN_ADMIN_INACTIVE_PRODUCTS:
        await message.reply(
            MESSAGES["admin_products_list_title"].format(status=MESSAGES["inactive_status"]),
            components=product_status_keyboard(context["admin_service"].list_products(active=False), back_callback="admin:products"),
        )
        return
    if text == BTN_ADMIN_STORE_LIST:
        await message.reply(
            MESSAGES["admin_stores_list_title"],
            components=stores_keyboard(context["admin_service"].list_stores(), "admin:store_select", back_callback="admin:stores"),
        )
        return
    if text == BTN_ADMIN_ACTIVE_STORES:
        stores = [s for s in context["admin_service"].list_stores() if s.get("active", True)]
        await message.reply(
            MESSAGES["admin_stores_list_title"],
            components=stores_keyboard(stores, "admin:store_select", back_callback="admin:stores"),
        )
        return
    if text == BTN_ADMIN_INACTIVE_STORES:
        stores = [s for s in context["admin_service"].list_stores() if not s.get("active", True)]
        await message.reply(
            MESSAGES["admin_stores_list_title"],
            components=stores_keyboard(stores, "admin:store_select", back_callback="admin:stores"),
        )
        return
    if text == BTN_ADMIN_EXPERT_LIST:
        await message.reply(
            MESSAGES["admin_experts_list_title"],
            components=experts_keyboard(context["admin_service"].list_experts(), "admin:expert_select", back_callback="admin:experts"),
        )
        return
    if text == BTN_ADMIN_ACTIVE_EXPERTS:
        experts = [e for e in context["admin_service"].list_experts() if e.get("active", True)]
        await message.reply(
            MESSAGES["admin_experts_list_title"],
            components=experts_keyboard(experts, "admin:expert_select", back_callback="admin:experts"),
        )
        return
    if text == BTN_ADMIN_INACTIVE_EXPERTS:
        experts = [e for e in context["admin_service"].list_experts() if not e.get("active", True)]
        await message.reply(
            MESSAGES["admin_experts_list_title"],
            components=experts_keyboard(experts, "admin:expert_select", back_callback="admin:experts"),
        )
        return
    if text == BTN_ADMIN_DISABLE_BOT:
        if get_role(message.author.id) == "admin":
            request = context["admin_service"].create_admin_action_request(
                title=MESSAGES["admin_request_title_bot"],
                action_type="bot_toggle",
                payload={"active": False},
                initiated_by=message.author.id,
            )
            await message.reply(MESSAGES["admin_request_created"].format(title=request["title"], request_id=request["id"]))
            try:
                await context["bot"].send_message(
                    SALES_MANAGER["telegram_id"],
                    MESSAGES["admin_action_request_detail"].format(
                        title=request["title"],
                        status=request["status"],
                        created_at=request["created_at"],
                    ),
                    components=admin_action_request_detail_keyboard(request),
                )
            except Exception:
                pass
        else:
            context["admin_service"].set_bot_active(False)
            await message.reply(MESSAGES["bot_status_updated"])
        return
    if text == BTN_ADMIN_ENABLE_BOT:
        if get_role(message.author.id) == "admin":
            request = context["admin_service"].create_admin_action_request(
                title=MESSAGES["admin_request_title_bot"],
                action_type="bot_toggle",
                payload={"active": True},
                initiated_by=message.author.id,
            )
            await message.reply(MESSAGES["admin_request_created"].format(title=request["title"], request_id=request["id"]))
            try:
                await context["bot"].send_message(
                    SALES_MANAGER["telegram_id"],
                    MESSAGES["admin_action_request_detail"].format(
                        title=request["title"],
                        status=request["status"],
                        created_at=request["created_at"],
                    ),
                    components=admin_action_request_detail_keyboard(request),
                )
            except Exception:
                pass
        else:
            context["admin_service"].set_bot_active(True)
            await message.reply(MESSAGES["bot_status_updated"])
        return

    if current_state in {
        ORDER_CATEGORY, ORDER_PRODUCT, ORDER_QUANTITY, ORDER_TRACKING,
        ORDER_FACTOR, ORDER_SUMMARY, ORDER_EDIT, ORDER_EDIT_FIELD,
    } and text in {BTN_BACK, BTN_CANCEL}:
        if text == BTN_CANCEL:
            await cancel_order(message, context)
        else:
            await back_order(message, context)
        return

    if text == BTN_BACK:
        role = get_role(message.author.id)
        context.pop("state", None)
        if role == "sales_manager":
            await message.reply(MESSAGES["sales_manager_start"], components=sales_manager_menu())
        elif role == "admin":
            await message.reply(MESSAGES["admin_start"], components=admin_menu())
        return

    # ====== جریان درخواست کالا ======
    if current_state == QUANTITY:
        await receive_quantity(message, context)
        return
    if current_state == SUMMARY:
        if text == BTN_ADD_ITEM:
            await add_item(message, context)
            return
        if text == BTN_EDIT_ITEM:
            await edit_item_menu(message, context)
            return
        if text == BTN_REMOVE_ITEM:
            await remove_item_menu(message, context)
            return
        if text == BTN_SUBMIT:
            await submit_request(message, context)
            return
        if text == BTN_CANCEL:
            await cancel_request(message, context)
            return
    if current_state == EDIT_QUANTITY:
        await receive_edit_quantity(message, context)
        return

    # ====== جریان ثبت سریال ======
    if current_state == ORDER_QUANTITY:
        await receive_order_quantity(message, context)
        return
    if current_state == ORDER_TRACKING:
        await receive_order_tracking(message, context)
        return
    if current_state == ORDER_FACTOR:
        await receive_order_factor(message, context)
        return
    if current_state == ORDER_SUMMARY:
        # ORDER_SUMMARY با دکمه‌های اینلاین کار می‌کند (در handle_callback_query)
        pass
    if current_state == ORDER_CUSTOM_REJECT_REASON:
        await receive_custom_rejection_reason(message, context)
        return

    # ====== ثبت‌نام ======
    if current_state == STORE_CODE:
        await receive_store_code(message, context)
        return
    if current_state == FULL_NAME:
        await receive_full_name(message, context)
        return
    if current_state == PHONE:
        await receive_phone(message, context)
        return

    # ====== کارشناس ======
    if current_state == EXPERT_REJECT_REASON:
        await receive_expert_reject_reason(message, context)
        return
    if current_state == EXPERT_EDIT_QUANTITY:
        await receive_request_item_quantity(message, context)
        return

    # ====== ویرایش فروشنده ======
    if current_state == EDIT_SELLER_NAME:
        await save_seller_name(message, context)
        return
    if current_state == EDIT_SELLER_PHONE:
        await save_seller_phone(message, context)
        return

    # ====== علت رد درخواست مدیریتی توسط مدیر فروش ======
    if current_state == ADMIN_REJECT_REASON:
        await receive_admin_reject_reason(message, context)
        return

    # ====== دستورات /start و غیره ======
    if text.startswith("/start"):
        await start(message, context)
        return
    if text.startswith("/info"):
        await bot_info(message, context)
        return
    if text.startswith("/export_requests"):
        await export_requests(message, context)
        return
    if text.startswith("/export_orders"):
        await export_orders(message, context)
        return


# ====== هندلر مرکزی CallbackQuery ======
async def handle_callback_query(callback: CallbackQuery, context: dict):
    data = callback.data
    current_state = get_state(context)

    logger.info(f"📩 handle_callback: state={current_state}, data={data}")

    if not _is_bot_access_allowed(callback.from_user.id, context["admin_service"]):
        await callback.message.edit(MESSAGES["bot_disabled"])
        return

    if data.startswith("admin:"):
        await admin_menu_callback(callback, context)
        return

    if data.startswith("order_nav:"):
        action = data.split(":", 1)[1]
        if action == "cancel":
            await cancel_order(callback.message, context)
        else:
            await back_order(callback.message, context)
        return

    # ====== جریان درخواست کالا ======
    if data.startswith("cat:") and current_state in (CATEGORY, None):
        await choose_category(callback, context)
        return
    if data.startswith("prod:") and current_state in (PRODUCT, None):
        await choose_product(callback, context)
        return
    if data.startswith("edit_item:"):
        await select_edit_item(callback, context)
        return
    if data.startswith("remove_item:"):
        await remove_item(callback, context)
        return
    if data.startswith("qty_change:"):
        await quantity_change_callback(callback, context)
        return

    # ====== جریان ثبت سریال ======
    if data.startswith("cat:") and current_state in (ORDER_CATEGORY, None):
        await choose_order_category(callback, context)
        return
    if data.startswith("prod:") and current_state in (ORDER_PRODUCT, None):
        await choose_order_product(callback, context)
        return
    if data.startswith("order_edit_unit:"):
        await choose_order_edit_unit(callback, context)
        return
    if data.startswith("order_edit_tracking:") or data.startswith("order_edit_factor:"):
        await choose_order_edit_field(callback, context)
        return
    if data.startswith("order_unit:"):
        await order_validation_callback(callback, context)
        return
    if data.startswith("order_reject_reason:"):
        await choose_order_rejection_reason(callback, context)
        return

    # ====== دکمه‌های اینلاین خلاصه سفارش ======
    if data == "order_submit":
        await submit_order(callback.message, context)
        await callback.message.delete()
        return
    if data == "order_edit":
        await edit_order_menu(callback.message, context)
        await callback.message.delete()
        return
    if data == "order_back":
        await back_order(callback.message, context)
        await callback.message.delete()
        return
    if data == "order_cancel":
        await cancel_order(callback.message, context)
        await callback.message.delete()
        return

    # ====== کارشناس ======
    if data.startswith("expert:"):
        await expert_request_callback(callback, context)
        return
    if data.startswith("expert_edit_item:"):
        await pick_request_item_to_edit(callback, context)
        return
    if data.startswith("edit_seller:"):
        await pick_seller_to_edit(callback, context)
        return
    if data.startswith("edit_seller_name:") or data.startswith("edit_seller_phone:"):
        await pick_seller_field(callback, context)
        return
    if data.startswith("seller:"):
        await seller_approval_callback(callback, context)
        return


# ====== ساخت ربات ======
def build_bot():
    if load_dotenv:
        load_dotenv()

    config = load_config()
    client = Bot(token=config.bot_token)

    db = get_database()

    shared_services = {
        "user_service": UserService(db),
        "request_service": RequestService(db),
        "order_service": OrderService(db),
        "admin_service": AdminService(),
        "bot": client,
    }        return session

    @client.listen('on_ready')
    async def on_ready():
        logger.info(f"بات {client.user} آماده است!")

    @client.listen('on_message')
    async def on_message(message: Message):
        context = get_session(message.author.id)
        if not _is_bot_access_allowed(message.author.id, context["admin_service"]):
            await message.reply(MESSAGES["bot_disabled"])
            return
        # Route text and media separately. For media (photos) we must
        # dispatch based on the current state so handlers like
        # `receive_order_tracking` and `receive_order_factor` are called.
        if message.content is not None:
            await handle_text(message, context)
            return

        # No text -> maybe media (photo). Route by state.
        current_state = get_state(context)
        if message.photos:
            if current_state == ORDER_QUANTITY:
                await receive_order_quantity(message, context)
                return
            if current_state == ORDER_TRACKING:
                await receive_order_tracking(message, context)
                return
            if current_state == ORDER_FACTOR:
                await receive_order_factor(message, context)
                return
        # Fallback: if message has text-like content (rare) let handle_text handle it
        # otherwise ignore other media types for now.

    @client.listen('on_callback')
    async def on_callback(callback: CallbackQuery):
        context = get_session(callback.from_user.id)
        await handle_callback_query(callback, context)

    return client


def main():
    logging.basicConfig(level=logging.INFO)
    client = build_bot()
    client.run()


if __name__ == "__main__":
    main()
